PROJECT_NAME=RAIL-PULSE
ENVIRONMENT=development
LOG_LEVEL=INFO

# Networking & Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://railpulse:railpulse_secret@localhost:5432/railpulse_db

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs (With Automatic Local Fallbacks)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_SECONDS=2.0

# Ingestion Mode (DEMO_SIMULATION, LIVE_POLLER, REPLAY)
DEFAULT_PROVIDER_MODE=DEMO_SIMULATION
DEMO_SPEED_MULTIPLIER=1.0

# Corridor Bounds (Bhadrak to Puri)
CORRIDOR_START_KM=0.0
CORRIDOR_END_KM=206.0
MIN_HEADWAY_MINS=10.0
DEFAULT_LOOP_IN_PENALTY_MINS=6.0
DEFAULT_SIGNAL_CLEAR_PENALTY_MINS=5.0
STATION_EXIT_PENALTY_MINS=12.0
